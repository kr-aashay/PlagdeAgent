PORT=6003

# PostgreSQL Database connection string for AI Pledge database
# Format: postgresql://[user[:password]@][host][:port][/dbname][?param1=value1&...]
DATABASE_URL=postgresql://username:password@localhost:5432/ai_pledge

# Existing University Database connection string (for department lookup)
# This should point to the university's existing database containing student/employee records
EXISTING_DB_URL=postgresql://username:password@localhost:5432/university_db

# Deployment sub-paths (must match nginx location blocks)
BASE_PATH=/oath
API_PATH=/APO
