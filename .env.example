PORT=6003

# MongoDB Atlas connection string
# Get from: Atlas → Connect → Drivers → Node.js
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ai_pledge?retryWrites=true&w=majority&appName=<AppName>

# Deployment sub-paths (must match nginx location blocks)
BASE_PATH=/oath
API_PATH=/APO
